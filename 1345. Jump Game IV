from collections import deque

class Solution:
    def minJumps(self, arr):
        n = len(arr)
        if n == 1:
            return 0

        pos = {}
        for i, x in enumerate(arr):
            pos.setdefault(x, []).append(i)

        q = deque([(0, 0)])
        seen = {0}

        while q:
            i, steps = q.popleft()

            if i == n - 1:
                return steps

            for j in [i - 1, i + 1] + pos[arr[i]]:
                if 0 <= j < n and j not in seen:
                    seen.add(j)
                    q.append((j, steps + 1))

            pos[arr[i]] = []

        return -1
