class Solution:
    def canReach(self, arr, start):
        seen = set()

        def dfs(i):
            if i < 0 or i >= len(arr) or i in seen:
                return False
            if arr[i] == 0:
                return True

            seen.add(i)
            return dfs(i + arr[i]) or dfs(i - arr[i])

        return dfs(start)
