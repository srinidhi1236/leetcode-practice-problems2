class Solution:
    def longestCommonPrefix(self, arr1, arr2):
        prefixes = set()

        for x in arr1:
            while x:
                prefixes.add(x)
                x //= 10

        ans = 0
        for x in arr2:
            while x:
                if x in prefixes:
                    ans = max(ans, len(str(x)))
                x //= 10

        return ans
